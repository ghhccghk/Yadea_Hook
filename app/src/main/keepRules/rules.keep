# Xposed module entry point — must not be obfuscated
-keep class com.ghhccghk.yadeahook.MainHook { *; }

# BroadcastReceivers — registered by name in manifest or code
-keep class com.ghhccghk.yadeahook.StatusUpdateReceiver { *; }
-keep class com.ghhccghk.yadeahook.ui.LogReceiver { *; }

# Keep hook base class and subclasses (accessed by reflection)
-keep class com.ghhccghk.yadeahook.BaseHook { *; }
-keep class com.ghhccghk.yadeahook.hooks.** { *; }

# Keep VehicleStatusStore (accessed by broadcast action string)
-keep class com.ghhccghk.yadeahook.VehicleStatusStore { *; }

# Keep VehicleController (accessed by reflection)
-keep class com.ghhccghk.yadeahook.VehicleController { *; }
